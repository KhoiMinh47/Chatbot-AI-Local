      "entrypoint": null,
      "environment": {
        "APP_DATABASE_HOST": "postgres",
        "APP_DATABASE_NAME": "ntc_rag",
        "APP_DATABASE_PORT": "5432",
        "APP_DATABASE_USER": "ntc_app",
        "APP_ENV": "development",
        "APP_HOST": "0.0.0.0",
        "APP_LOG_LEVEL": "info",
        "APP_MINIO_HEALTH_URL": "http://minio:9000/minio/health/ready",
        "APP_PORT": "8000",
        "APP_QDRANT_HEALTH_URL": "http://qdrant:6333/healthz",
        "APP_RABBITMQ_HEALTH_URL": "http://rabbitmq:15672/api/health/checks/virtual-hosts",
        "APP_RABBITMQ_USER": "ntc_worker",
        "APP_REDIS_HOST": "redis",
        "APP_REDIS_PORT": "6379"
      },
      "expose": [
        "8000"
      ],
      "group_add": [
        "1000"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=2).read()"
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 20,
        "start_period": "10s"
      },
      "image": "ntc-rag-phase2-api:0.2.0",
      "mem_limit": "2147483648",
      "networks": {
        "internal": null
      },
      "pids_limit": 256,
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "postgres_password",
          "target": "APP_DATABASE_PASSWORD"
        },
        {
          "source": "redis_password",
          "target": "APP_REDIS_PASSWORD"
        },
        {
          "source": "rabbitmq_password",
          "target": "APP_RABBITMQ_PASSWORD"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:mode=1777"
      ]
