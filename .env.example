# Non-secret local overrides for the Phase 1 skeleton and Phase 2/3 tooling.
# Copy to .env and source it explicitly; the repository does not auto-load it.
# Never put credentials here. Phase 2/3 credentials live under .secrets/.

# Standalone Phase 1 API defaults.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info

# Standalone Phase 1 Celery report only. Compose constructs its broker URL from
# a runtime secret file; this reserved .invalid endpoint is never used there.
CELERY_BROKER_URL=amqp://broker.invalid:5672//

# Phase 2 non-secret paths and local runtime controls.
PHASE2_ENV_FILE=infra/compose/phase2.env
PHASE2_SECRET_DIR=.secrets/phase2
PHASE2_PROXY_PORT=8080
PHASE2_IMAGE_PULL_TIMEOUT_SECONDS=1200
PHASE2_IMAGE_PULL_ATTEMPTS=3
PHASE2_WAIT_TIMEOUT_SECONDS=300
PHASE2_KEEP_RUNNING=0

# PHASE2_SECRET_GID intentionally has no hard-coded value. Scripts default to
# `id -g`; export a numeric GID manually only when the secret runtime group must
# differ from the current user's primary group.

# Phase 3 NIM bake-off controls. The default acceptance workload is the reviewed
# 20-request matrix and includes 32K/64K/128K capability tests. Cache staging is
# explicit because it temporarily enables model-registry egress.
PHASE3_ENV_FILE=infra/compose/phase3.env
PHASE3_STAGE_CACHES=0
PHASE3_MEASURED_REQUESTS=20
PHASE3_WARMUP_REQUESTS=2
PHASE3_INCLUDE_LONG_CONTEXT=1
PHASE3_COMBINATION_LLM=nemotron
PHASE3_READY_TIMEOUT_SECONDS=3600
PHASE3_REQUEST_TIMEOUT_SECONDS=600

# Application-side NIM adapters remain disabled unless the selected LLM and
# embedding pair is configured; reranking is optional. Base URLs must be
# credential-free and end in /v1. Runtime NIM
# services are private and publish no host ports, so use addresses reachable
# from the API process rather than copying container IPs into source control.
APP_NIM_CLIENTS_ENABLED=false
APP_NIM_TIMEOUT_SECONDS=120
APP_NIM_MAX_RETRIES=2
APP_NIM_RETRY_DELAY_SECONDS=0.1
APP_NIM_EMBED_MAX_BATCH_SIZE=32
APP_NIM_EMBED_ALLOW_BATCH_DOWNSHIFT=true
APP_NIM_EMBED_MIN_DOWNSHIFT_BATCH_SIZE=1

# Required together when APP_NIM_CLIENTS_ENABLED=true:
# APP_NIM_LLM_BASE_URL=http://nim-llm-nemotron:8000/v1
# APP_LLM_HEALTH_URL=http://nim-llm-nemotron:8000/v1/health/ready
# APP_NIM_LLM_MODEL=nvidia/nemotron-nano-9b-v2
# APP_NIM_LLM_MODEL_VERSION=1.0.0
# APP_NIM_EMBED_BASE_URL=http://nim-embedding-300m:8000/v1
# APP_NIM_EMBED_MODEL=nvidia/llama-nemotron-embed-300m-v2
# APP_NIM_EMBED_MODEL_VERSION=1.13.0
# APP_EMBEDDING_DIMENSION=2048
# APP_NIM_RERANK_BASE_URL=http://nim-reranking-500m:8000/v1
# APP_NIM_RERANK_MODEL=nvidia/llama-nemotron-rerank-500m-v2
# APP_NIM_RERANK_MODEL_VERSION=1.10.0

# Chatbot quality rollout flags. Compose enables memory, hybrid retrieval and
# adaptive reasoning after migrations; reranking remains an explicit experiment
# until its NIM service and held-out quality benchmark are available.
ENABLE_NEW_MEMORY=true
MEMORY_RECENT_MAX_TURNS=16
MEMORY_RECENT_TOKEN_LIMIT=12000
ENABLE_ROLLING_SUMMARY=true
ENABLE_LONG_TERM_MEMORY=true
MEMORY_SUMMARY_SOURCE_LIMIT=128
MEMORY_SEMANTIC_CANDIDATE_LIMIT=200
MEMORY_SEMANTIC_FINAL_LIMIT=6
ENABLE_HYBRID_RETRIEVAL=true
RAG_RRF_K=60
RAG_DENSE_WEIGHT=1.0
RAG_LEXICAL_WEIGHT=1.0
ENABLE_RERANKER=false
ENABLE_ADAPTIVE_REASONING=true
RAG_MAX_CONCURRENCY=4
